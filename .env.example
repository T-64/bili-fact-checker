# Bilibili login cookie (or put SESSDATA in ~/.config/bili/SESSDATA)
BILI_SESSDATA=

# LLM (OpenAI-compatible). z.ai example:
# OPENAI_API_BASE=https://api.z.ai/api/paas/v4
# OPENAI_API_KEY=...
# OPENAI_MODEL=glm-4-flash
# Or set GLM_API_KEY (also read from ~/.hermes/.env)
GLM_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.z.ai/api/paas/v4
OPENAI_MODEL=glm-4-flash

# Google Fact Check Tools API
GOOGLE_FACTCHECK_API_KEY=

# Optional web search
# SEARXNG_URL=http://127.0.0.1:8080
# TAVILY_API_KEY=

HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890

# Local Whisper CTranslate2 model path (for --asr)
WHISPER_MODEL=~/whisper-model
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
