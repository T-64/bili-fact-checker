# Bilibili login cookie (or put SESSDATA in ~/.config/bili/SESSDATA)
BILI_SESSDATA=

# LLM (OpenAI-compatible). z.ai example:
# OPENAI_API_BASE=https://api.z.ai/api/paas/v4
# OPENAI_API_KEY=...
# OPENAI_MODEL=glm-4-flash
# Or set GLM_API_KEY (also read from ~/.hermes/.env)
GLM_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.z.ai/api/paas/v4
OPENAI_MODEL=glm-4-flash
# auto detects native Gemini/Anthropic hosts; all other endpoints use the
# OpenAI-compatible Chat Completions protocol.
LLM_PROVIDER=auto

# Search defaults to a known AI provider's native search protocol.
# Z.AI uses GLM Coding Plan MCP web_search_prime, not /web_search REST.
# Native search adapters: Z.AI, OpenAI, Gemini, Anthropic.
SEARCH_PROVIDER=auto
BFC_MAX_SEARCHES_PER_CLAIM=3
BFC_MAX_TOTAL_SEARCHES=30
BFC_SEARCH_RESULTS=5
# Set either TTL to 0 to disable that cache.
BFC_CACHE_DIR=~/.cache/bili-fact-checker
BFC_SEARCH_CACHE_TTL=86400
BFC_PAGE_CACHE_TTL=604800

# Local API persistence and queue. API auth is optional on loopback. Any
# non-loopback bind (including the Docker container's 0.0.0.0 bind) requires a
# random token of at least 32 characters. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Local setup wizard: bili-fact-checker setup --save
# (writes ~/.config/bili-fact-checker/config.json; env vars still win)
BFC_DATA_DIR=~/.local/share/bili-fact-checker
BFC_JOB_WORKERS=2
BFC_JOB_QUEUE_SIZE=8
BFC_API_TOKEN=

# Evidence passage ranking. lexical has no model download. Optional:
# pip install 'bili-fact-checker[local-ml]' && BFC_EVIDENCE_RERANKER=bge
BFC_EVIDENCE_RERANKER=lexical
BFC_EVIDENCE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Optional external fallback. Set SEARCH_PROVIDER=searxng or tavily explicitly.
# SEARXNG_URL=http://127.0.0.1:8080
# TAVILY_API_KEY=
# A distinct search account/endpoint is optional; otherwise the LLM values above
# are reused for native search.
# BFC_SEARCH_API_KEY=
# BFC_SEARCH_API_BASE=

# Optional network proxy. Leave blank on a normal installation.
HTTP_PROXY=
HTTPS_PROXY=

# Local Whisper (only needed when the video has no CC/AI subtitles)
# Install: pip install 'bili-fact-checker[asr]'
# Model must be CTranslate2 format (faster-whisper). If missing, use:
#   bili-fact-checker run BV... --transcript out.srt
# (e.g. generate out.srt with VideoCaptioner or another ASR tool)
WHISPER_MODEL=~/whisper-model
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
